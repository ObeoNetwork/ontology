extend type Mutation {
    uploadOWLFile(input: UploadOWLFileInput!): UploadOWLFilePayload!
}

input UploadOWLFileInput {
    editingContextId: ID!
    file: Upload!
    id: ID!
}

union UploadOWLFilePayload = ErrorPayload | UploadOWLFileSuccessPayload

type UploadOWLFileSuccessPayload {
    id: ID!
    report: String
}
